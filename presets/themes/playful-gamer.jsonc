// OpenCut theme preset. A pipeline loads this file and applies the knobs
// onto a project. See presets/README.md for how each group lands in the editor.
// Comments say what the knob does.
{
  // Stable id a pipeline passes to the editor. Do not rename it.
  "id": "playful-gamer",
  // Semver of this knob set. A daily cut records the version it was made with.
  "version": "1.1.0",
  // Browse group on the daily index.
  "category": "play",
  // Human name shown on the index and in the editor.
  "name": "Playful gamer",
  // One sentence the edit should feel like.
  "summary": "HUD type, acid green, and a pop into the hit.",
  // Overall look: mood, how crowded the frame is, and the canvas.
  "style": {
    // Short intent the pipeline should not contradict.
    "mood": "playful, competitive, bright",
    // How many layers may sit on screen. sparse is one picture and one title.
    "density": "packed",
    // Surface name: matte, punchy, glossy, pastel, or mono.
    "finish": "punchy",
    // Aspect label for humans. The pixels live on canvas.
    "aspect": "9:16",
    // Output frame in pixels. Maps to project settings.canvasSize.
    "canvas": {
      // Frame width in pixels.
      "width": 1080,
      // Frame height in pixels.
      "height": 1920
    },
    // preset for 1920x1080, 1080x1920, 1080x1080, or 1440x1080. Otherwise custom.
    "canvasSizeMode": "preset"
  },
  // How long shots hold, and the playback rate.
  "pace": {
    // Length of the finished cut in seconds. Daily references aim at about 10.
    "targetDurationSeconds": 10,
    // How long one shot may hold before the next cut.
    "shotLengthSeconds": {
      // Shortest hold, in seconds.
      "min": 1.2,
      // Longest hold, in seconds.
      "max": 2
    },
    // True prefers cuts on a beat. False follows the gesture.
    "cutOnBeat": true,
    // Still time after the last action, before the out transition.
    "holdTailSeconds": 0.3,
    // Playback rate. Maps to retime.rate. Below 1 is slower.
    "speed": 1.05,
    // Keep pitch when speed is not 1. Maps to retime.maintainPitch.
    "maintainPitch": true
  },
  // Palette. This is the design color, not the image grade.
  "colour": {
    // Canvas background hex. Used when backgroundBlur is 0.
    "background": "#10120f",
    // Primary type color.
    "ink": "#10120f",
    // Secondary type color, used for a credit line.
    "muted": "#9aa892",
    // One highlight, used for caption chips.
    "accent": "#c6ff3a",
    // Canvas background blur, 0 to 100. Above 0 switches the background to blur.
    "backgroundBlur": 0
  },
  // Type system. fontSize is the editor design size, not pixels.
  "typography": {
    // Headline fontFamily. The web shell loads Playfair Display.
    "displayFamily": "Inter",
    // Secondary fontFamily. Inter is the app body face.
    "bodyFamily": "Inter",
    // Headline weight. The text element stores normal or bold.
    "displayWeight": "bold",
    // Body weight.
    "bodyWeight": "bold",
    // Headline fontStyle.
    "fontStyle": "normal",
    // textAlign.
    "align": "center",
    // Design size. Pixels = fontSize * canvasHeight / 90. Editor range is 5 to 300.
    "fontSize": 5,
    // letterSpacing. 0 is the editor default.
    "letterSpacing": 1.2,
    // lineHeight multiplier. The editor default is 1.2.
    "lineHeight": 0.95,
    // Transform applied to the lines before they are drawn.
    "case": "upper",
    // Chip behind the type. Maps to background.* text params.
    "textBackground": {
      // Draw the chip. Captions want this on.
      "enabled": true,
      // Chip fill.
      "color": "#c6ff3a",
      // Chip corner radius, 0 to 100.
      "cornerRadius": 2,
      // Horizontal chip padding.
      "paddingX": 18,
      // Vertical chip padding.
      "paddingY": 8
    }
  },
  // How the picture enters, leaves, and hands off. Expanded into keyframes.
  "transitions": {
    // How the cut opens.
    "in": {
      // dissolve, cut, slide-left, or dip-white. The pipeline turns this into opacity and position keyframes.
      "kind": "cut",
      // Length of this transition. 0 is a hard cut.
      "seconds": 0,
      // Editor graph-editor easing.
      "easing": {
        // Builtin id: smooth, ease-out, ease-in, ease-in-out, pop, or linear.
        "id": "linear",
        // Cubic bezier for that builtin.
        "bezier": [0, 0, 1, 1]
      }
    },
    // How the cut ends.
    "out": {
      // dissolve, cut, slide-left, or dip-white. The pipeline turns this into opacity and position keyframes.
      "kind": "dip-white",
      // Length of this transition. 0 is a hard cut.
      "seconds": 0.12,
      // Editor graph-editor easing.
      "easing": {
        // Builtin id: smooth, ease-out, ease-in, ease-in-out, pop, or linear.
        "id": "linear",
        // Cubic bezier for that builtin.
        "bezier": [0, 0, 1, 1]
      }
    },
    // How two shots hand off.
    "between": {
      // dissolve, cut, slide-left, or dip-white. The pipeline turns this into opacity and position keyframes.
      "kind": "slide-left",
      // Length of this transition. 0 is a hard cut.
      "seconds": 0.16,
      // Editor graph-editor easing.
      "easing": {
        // Builtin id: smooth, ease-out, ease-in, ease-in-out, pop, or linear.
        "id": "pop",
        // Cubic bezier for that builtin.
        "bezier": [0.175, 0.885, 0.32, 1.275]
      }
    }
  },
  // Clock the editor stores. Ticks, then the frame rate.
  "timing": {
    // MediaTime resolution. Always 120000.
    "ticksPerSecond": 120000,
    // Frame rate rational on the project.
    "fps": {
      // Frame rate numerator.
      "numerator": 60,
      // Frame rate denominator. 1 for integer rates.
      "denominator": 1
    }
  },
  // Image treatment on the picture, separate from the palette.
  "grade": {
    // 1 leaves contrast alone. Above 1 adds punch.
    "contrast": 1.08,
    // 1 is the original color. 0 is grey.
    "saturation": 1.08,
    // Added brightness. 0 is unchanged. Negative crushes.
    "brightness": 0,
    // Warmth. 0 is neutral. Positive is warmer.
    "temperature": -1,
    // Midtone gamma. 1 is unchanged. Above 1 lifts mids.
    "gamma": 1.02,
    // Blur effect intensity, 0 to 100. 0 stays sharp.
    "blurIntensity": 0
  },
  // On-screen words and where they sit.
  "type": {
    // Default copy. A cut may replace these lines.
    "lines": [
      "gg",
      "one more"
    ],
    // Title offset from center as a fraction of height. Positive is down.
    "positionYFraction": -0.38,
    // Inset from the side for left or right type, as a fraction of width.
    "safeMarginFraction": 0.06,
    // When true, add a second text element with creditText.
    "credit": false,
    // Attribution line. Drawn only when credit is true.
    "creditText": ""
  },
  // Scale and drift across the cut.
  "motion": {
    // Scale at the first frame.
    "startScale": 1,
    // Scale at the last frame. A small rise is a slow push.
    "endScale": 1.03,
    // Vertical drift in output pixels. Negative moves the picture up.
    "positionDriftY": 0,
    // Easing of the scale and drift.
    "easing": {
      // Builtin id: smooth, ease-out, ease-in, ease-in-out, pop, or linear.
      "id": "pop",
      // Cubic bezier for that builtin.
      "bezier": [0.175, 0.885, 0.32, 1.275]
    },
    // Constant rotation in degrees. 0 is upright.
    "rotateDegrees": 0
  },
  // How the picture meets the frame: fit, bars, blend, volume.
  "compositing": {
    // contain keeps the whole gesture. cover fills the frame and crops.
    "fit": "cover",
    // Drop baked-in black bars before fitting.
    "cropSourceLetterbox": true,
    // Frame mask, or null when the picture is unmasked.
    "mask": null,
    // blendMode. normal is the editor default.
    "blendMode": "normal",
    // Source audio level from 0 to 1.
    "volume": 0.85
  },
  // What changed in each version of these knobs, and why.
  "changelog": [
    {
      "version": "1.0.0",
      // What changed in the knobs, and why.
      "note": "Initial knob set. Cover fit, 60 fps, pop easing, and a short slide between shots."
    },
    {
      "version": "1.1.0",
      // What changed in the knobs, and why.
      "note": "The 10s conform of the Wildwasser multi-ball showed the problems. The acid chip at position 0.34 and fontSize 7 sat across the lower playfield and covered the lit targets. Contrast 1.22, saturation 1.28, brightness 0.02, and temperature -4 pushed the orange inserts toward the chip's lime. A 6 percent push on an already tight 9:16 cover ate the side art. 1.1.0 lifts the chip to -0.38 at fontSize 5 so both lines sit in the dark glass, holds the grade at contrast 1.08, saturation 1.08, brightness 0, and temperature -1, and shortens the push to 3 percent. The 60 fps cover and the hard open stay."
    }
  ]
}
